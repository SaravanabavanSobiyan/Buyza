# Public API base URL; VITE_ values are compiled into the browser bundle.
VITE_API_URL=/api
# Public Google reCAPTCHA site key; never put the secret key here.
VITE_RECAPTCHA_SITE_KEY=your-public-recaptcha-site-key
# Optional public Sentry DSN; create one in the Sentry project to enable client reports.
VITE_SENTRY_DSN=
# Canonical public storefront URL used in metadata.
VITE_SITE_URL=http://localhost:5173
# Keep false locally and in staging; enable only for production.
VITE_ALLOW_INDEXING=false
