# Runtime mode. Use production only with the production settings below.
NODE_ENV=development
# HTTP port for the API.
PORT=5000
# MongoDB replica-set URI. Local transactions require replicaSet=rs0.
MONGO_URI=mongodb://127.0.0.1:27017/mern_ecommerce?replicaSet=rs0
# Public frontend URL used for email links and OAuth redirects.
CLIENT_URL=http://localhost:5173
# Exact, comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173
# Number of trusted reverse-proxy hops; set this to match the deployment host.
TRUST_PROXY_HOPS=0
# Enable only after HTTPS is confirmed for the production domain.
ENABLE_HSTS=false
# Public API URL used when generating links and metadata.
API_URL=http://localhost:5000/api
# Canonical public site URL; production must use HTTPS.
SITE_URL=http://localhost:5173
# Allow search engines to index the production storefront.
ALLOW_INDEXING=false
# Local-only placeholder; replace with a unique random value of at least 32 characters.
JWT_ACCESS_SECRET=dev-only-access-secret-replace-with-random-32-bytes
# Local-only placeholder; use a different random value of at least 32 characters.
JWT_REFRESH_SECRET=dev-only-refresh-secret-replace-with-random-32-bytes
# Access-token lifetime accepted by jsonwebtoken.
JWT_ACCESS_EXPIRES=15m
# SMTP server host; leave blank to use a development test inbox.
SMTP_HOST=
# SMTP server port, commonly 587 or 465.
SMTP_PORT=587
# SMTP username, if authentication is required.
SMTP_USER=
# SMTP password, if authentication is required.
SMTP_PASS=
# Sender identity shown on transactional email.
EMAIL_FROM="My Store <orders@yourdomain.com>"
# Store name used in messages and fallback sender identity.
STORE_NAME=
# Server-side reCAPTCHA secret; never expose this as a VITE_ variable.
RECAPTCHA_SECRET=
# Cloudinary account cloud name for production image uploads.
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key for production image uploads.
CLOUDINARY_API_KEY=
# Cloudinary API secret; keep this server-side only.
CLOUDINARY_API_SECRET=
# Required only when creating the initial admin account.
ADMIN_EMAIL=
# Required only when creating the initial admin account; use a unique 12+ character password.
ADMIN_PASSWORD=
# Google OAuth client ID; optional.
GOOGLE_CLIENT_ID=
# Google OAuth client secret; optional and server-side only.
GOOGLE_CLIENT_SECRET=
# Facebook OAuth app ID; optional.
FACEBOOK_APP_ID=
# Facebook OAuth app secret; optional and server-side only.
FACEBOOK_APP_SECRET=
